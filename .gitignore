# Visual Studio / ASP.NET Core .gitignore
# Keeps build output and personal settings out of the repo — only source code gets pushed.

# Build results (regenerated on every build — never commit)
bin/
obj/
[Dd]ebug/
[Rr]elease/

# Deployment packages produced by "dotnet publish" for AWS.
# A self-contained build is ~173 MB and about 436 of its DLLs are the .NET
# runtime itself. It is build output, not source: anyone can recreate it with
#     dotnet publish -c Release -r linux-x64 --self-contained true -o publish-out
# Committing it would bloat the repo and can be rejected by GitHub.
publish-out/
publish/
[Pp]ublish/
*.zip

# Visual Studio user-specific files (personal window layouts, breakpoints etc.)
.vs/
*.user
*.suo
*.userosscache

# Local secrets — NEVER commit real credentials.
# Use appsettings.Development.json locally; commit only appsettings.json with placeholders.
appsettings.Development.json
*.pfx

# EC2 key pair private keys (e.g. grantifyAccess.pem). Anyone holding one of
# these can log in to our server, so they must never reach GitHub. Keep the
# file outside this folder as well.
*.pem
*.ppk

# LocalDB database files (each member has their own DB — rebuilt via Update-Database)
*.mdf
*.ldf

# Documents students upload while testing (transcripts, payslips, IC copies).
# NEVER commit these:
#   - they are personal data, and this repo is on GitHub
#   - they are runtime data, not source code
#   - the folder is created automatically by StudentService when a file is
#     uploaded, so nothing breaks by leaving it out
#   - the file names contain the application id, and everyone's ids differ
#     after Drop-Database, so committed files would just be orphans
# In Task 2 these move to Amazon S3 and this folder disappears entirely.
Grantify/App_Data/uploads/

# NuGet packages (restored automatically from the .csproj on build)
packages/
*.nupkg

# AWS deployment artifacts
aws-beanstalk-tools-defaults.json.user
