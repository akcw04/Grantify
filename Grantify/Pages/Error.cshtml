@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

@* SHARED PAGE. Shown to a USER when an unhandled error happens on the deployed
   site (wired up in Program.cs with app.UseExceptionHandler("/Error")).

   The version the project template ships with explained how to switch the app
   into Development mode to see the exception — instructions written for a
   developer, shown to whoever hit the error. It said nothing useful to a
   student and hinted at settings nobody outside the team should be thinking
   about. This one tells the person what happened, gives them the request id to
   quote, and points them back somewhere that works.

   On our own machines this page is not used at all: Development shows the
   detailed exception page instead, which is what we want while building. *@

<div class="d-flex flex-column align-items-center justify-content-center text-center"
     style="min-height: 60vh;">

    <h1 class="h3 mb-3">Something went wrong</h1>

    <p class="text-muted mb-4" style="max-width: 32rem;">
        Sorry — the page could not be loaded. Nothing you were part-way through has been lost,
        so it is usually safe to go back and try again.
    </p>

    @if (Model.ShowRequestId)
    {
        @* Quoting this lets us find the exact failure in the server log. *@
        <p class="cell-sub mb-4">
            If you report this, please quote reference <code>@Model.RequestId</code>.
        </p>
    }

    <div class="d-flex flex-wrap gap-2 justify-content-center">
        @* Send people to their OWN area rather than a page they cannot open. *@
        @if (User.IsInRole("Student"))
        {
            <a class="btn btn-primary" asp-area="" asp-page="/Student/Index">Go to my dashboard</a>
        }
        else if (User.IsInRole("Officer"))
        {
            <a class="btn btn-primary" asp-area="" asp-page="/Officer/Index">Go to my dashboard</a>
        }
        else if (User.IsInRole("Admin"))
        {
            <a class="btn btn-primary" asp-area="" asp-page="/Admin/Analytics/Index">Go to my dashboard</a>
        }
        <a class="btn btn-outline-secondary" asp-area="" asp-page="/Index">Home</a>
    </div>

</div>
