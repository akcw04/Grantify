@model Grantify.Models.DocumentStatus

@* SHARED PARTIAL — announce in the group chat before changing.

   Shows one document status as a coloured badge. Same idea as
   _ApplicationStatusBadge: the colour and the wording live in one place, so a
   student and an officer describe the same file the same way.

   Use it with:  <partial name="_DocumentStatusBadge" model="document.Status" /> *@

@{
    var (cssClass, label) = Model switch
    {
        DocumentStatus.Verified => ("bg-success", "Verified"),
        DocumentStatus.Flagged => ("bg-danger", "Flagged"),
        _ => ("bg-secondary", "Pending")
    };
}

<span class="badge @cssClass">@label</span>
