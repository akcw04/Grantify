@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Grantify</h1>
    <p class="lead">Smart Scholarship Application and Review Portal</p>
</div>

@* Example of showing data from the database. The list comes from
   ScholarshipService — see Pages/Index.cshtml.cs for the pattern. *@
<h2 class="h4 mt-4">Open Scholarships</h2>

@if (Model.Scholarships.Count == 0)
{
    <p class="text-muted">No scholarships are published yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Provider</th>
                <th>Minimum CGPA</th>
                <th>Deadline</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var scholarship in Model.Scholarships)
            {
                <tr>
                    <td>@scholarship.Name</td>
                    <td>@scholarship.Provider</td>
                    <td>@scholarship.MinimumCgpa.ToString("0.00")</td>
                    <td>@scholarship.Deadline.ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}
