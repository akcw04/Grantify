@page
@model Grantify.Pages.Officer.IndexModel
@{
    ViewData["Title"] = "Officer Dashboard";
}

@* OWNER: Member B (Officer role). Build all officer pages inside Pages/Officer/.
   STYLING NOTE: deliberately minimal — spacing and colour only, close to plain
   Bootstrap. When the team agrees a shared theme in site.css, officer.css gets
   trimmed rather than rewritten. *@

<div class="officer-page">

    <h1>Scholarship Officer Dashboard</h1>
    <p class="text-muted">Welcome, @User.Identity?.Name. Here is what is waiting for you.</p>

    <partial name="_StatusMessage" model="(Model.StatusMessage, Model.StatusIsError)" />

    @* ---------- Counts ---------- *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">New</div>
                <div class="stat-value">@Model.Dashboard.Submitted</div>
                <div class="stat-note">nobody has opened these yet</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">Under review</div>
                <div class="stat-value">@Model.Dashboard.UnderReview</div>
                <div class="stat-note">an officer is working on these</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">Shortlisted</div>
                <div class="stat-value">@Model.Dashboard.Shortlisted</div>
                <div class="stat-note">waiting for a final decision</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">Decided</div>
                <div class="stat-value">@(Model.Dashboard.Approved + Model.Dashboard.Rejected)</div>
                <div class="stat-note">
                    @Model.Dashboard.Approved approved &middot; @Model.Dashboard.Rejected rejected
                </div>
            </div>
        </div>
    </div>

    @* ---------- Things that need attention ---------- *@
    @if (Model.Dashboard.OverdueApplications > 0)
    {
        <div class="alert alert-warning">
            <strong>@Model.Dashboard.OverdueApplications</strong> application(s) are still undecided
            even though the scholarship deadline has passed.
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-primary" asp-page="Applications">
            Open application queue (@Model.Dashboard.OpenTotal)
        </a>
        <a class="btn btn-outline-secondary" asp-page="Documents">
            Verify documents (@Model.Dashboard.PendingDocuments pending,
            @Model.Dashboard.FlaggedDocuments flagged)
        </a>
    </div>

    @* ---------- Shortcut list ---------- *@
    <h2>Waiting longest</h2>
    @if (Model.NextUp.Count == 0)
    {
        <p class="text-muted">Nothing is waiting for review right now.</p>
    }
    else
    {
        @* This is a shortcut, not the full list. Say so plainly — otherwise an
           officer who cannot find a specific application here thinks it is
           missing, when it is simply below the cut. *@
        @if (Model.Dashboard.OpenTotal > Model.NextUp.Count)
        {
            <p class="cell-sub">
                Showing the @Model.NextUp.Count longest-waiting of
                @Model.Dashboard.OpenTotal still open.
                <a asp-page="Applications">See all in the queue</a>.
            </p>
        }
        <div class="table-scroll">
            <table class="table queue-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Scholarship</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.NextUp)
                    {
                        <tr class="@(item.IsOverdue ? "row-overdue" : null)">
                            <td>@item.StudentName</td>
                            <td>@item.ScholarshipName</td>
                            <td>@item.SubmittedOn.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td><partial name="_ApplicationStatusBadge" model="item.Status" /></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-page="Review" asp-route-id="@item.ApplicationId">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@* These two blocks load the Officer-only css and js on this page.
   Copy them onto every new Officer page you create. *@
@section Styles {
    <link rel="stylesheet" href="~/css/officer/officer.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/officer/officer.js" asp-append-version="true"></script>
}
