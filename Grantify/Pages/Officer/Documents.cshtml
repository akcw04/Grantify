@page
@model Grantify.Pages.Officer.DocumentsModel
@{
    ViewData["Title"] = "Document Verification";
}

@* OWNER: Member B. Styling is deliberately minimal — see officer.css. *@

<div class="officer-page">

    <h1>Document Verification</h1>
    <p class="text-muted">
        Every supporting file that still needs a decision, oldest upload first.
    </p>

    <partial name="_StatusMessage" model="(Model.StatusMessage, Model.StatusIsError)" />

    <form method="get" class="filter-bar row g-2 align-items-end mb-4">
        <div class="col-12 col-md-4">
            <label class="form-label" asp-for="Status">Show</label>
            <select class="form-select form-select-sm" asp-for="Status"
                    asp-items="Html.GetEnumSelectList<DocumentStatus>()">
                <option value="">Needs attention (pending + flagged)</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-success">
            Nothing to check — every document has been dealt with.
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="table queue-table">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Student</th>
                        <th>Scholarship</th>
                        <th>Status</th>
                        <th style="min-width: 22rem;">Decision</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                @* Opens in a new tab so the queue stays where it is. *@
                                <div class="document-name">
                                    <a asp-page-handler="File"
                                       asp-route-documentId="@item.DocumentId"
                                       target="_blank" rel="noopener">@item.FileName</a>
                                </div>
                                <div class="cell-sub">
                                    uploaded @item.UploadedOn.ToLocalTime().ToString("dd MMM yyyy")
                                </div>
                            </td>
                            <td>@item.StudentName</td>
                            <td>@item.ScholarshipName</td>
                            <td>
                                <partial name="_DocumentStatusBadge" model="item.Status" />
                                @if (!string.IsNullOrWhiteSpace(item.OfficerNote))
                                {
                                    <div class="cell-sub mt-1">@item.OfficerNote</div>
                                }
                            </td>
                            <td>
                                @* The note box starts EMPTY on purpose — carrying an old
                                   flagging reason into a verification would be misleading. *@
                                <form method="post" asp-page-handler="SetStatus" class="row g-1">
                                    <input type="hidden" name="documentId" value="@item.DocumentId" />
                                    <div class="col-12 col-xl-6">
                                        <input class="form-control form-control-sm" name="note"
                                               placeholder="Note (required when flagging)" />
                                    </div>
                                    <div class="col-auto">
                                        <button type="submit" class="btn btn-sm btn-outline-success"
                                                name="documentStatus" value="@DocumentStatus.Verified">
                                            Verify
                                        </button>
                                    </div>
                                    <div class="col-auto">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                name="documentStatus" value="@DocumentStatus.Flagged">
                                            Flag
                                        </button>
                                    </div>
                                    <div class="col-auto">
                                        @* from=documents tells the review page to send
                                           the officer back HERE, not to the queue. *@
                                        <a class="btn btn-sm btn-link"
                                           asp-page="Review"
                                           asp-route-id="@item.ApplicationId"
                                           asp-route-from="documents">Open application</a>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/officer/officer.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/officer/officer.js" asp-append-version="true"></script>
}
