@model Grantify.Models.ApplicationStatus

@* OWNER: Member B. Shows one application status as a coloured pill.
   Used on the dashboard, the queue and the review page, so the colour and
   the wording of a status are decided in ONE place only.
   Use it with:  <partial name="_ApplicationStatusBadge" model="item.Status" /> *@

@{
    // Class name and human wording for each status.
    var (cssClass, label) = Model switch
    {
        ApplicationStatus.Submitted => ("status-submitted", "New"),
        ApplicationStatus.UnderReview => ("status-underreview", "Under review"),
        ApplicationStatus.Shortlisted => ("status-shortlisted", "Shortlisted"),
        ApplicationStatus.Approved => ("status-approved", "Approved"),
        ApplicationStatus.Rejected => ("status-rejected", "Rejected"),
        _ => ("status-pending", Model.ToString())
    };
}

<span class="status-badge @cssClass">@label</span>
