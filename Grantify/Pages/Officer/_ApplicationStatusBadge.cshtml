@model Grantify.Models.ApplicationStatus

@* OWNER: Member B. Shows one application status as a coloured badge.
   Used on the dashboard, the queue and the review page, so the colour and the
   wording of a status are decided in ONE place only.
   Use it with:  <partial name="_ApplicationStatusBadge" model="item.Status" />

   The colours and wording deliberately MATCH Member A's student pages
   (Pages/Student/Applications.cshtml). A student seeing a grey "Submitted"
   badge and an officer seeing a blue "New" pill for the same application makes
   the system look like two different products. *@

@{
    var (cssClass, label) = Model switch
    {
        ApplicationStatus.Submitted => ("bg-secondary", "Submitted"),
        ApplicationStatus.UnderReview => ("bg-warning text-dark", "Under review"),
        ApplicationStatus.Shortlisted => ("bg-primary", "Shortlisted"),
        ApplicationStatus.Approved => ("bg-success", "Approved"),
        ApplicationStatus.Rejected => ("bg-danger", "Rejected"),
        _ => ("bg-secondary", Model.ToString())
    };
}

<span class="badge @cssClass">@label</span>
