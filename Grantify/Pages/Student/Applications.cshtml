@page
@model Grantify.Pages.Student.ApplicationsModel
@{
    ViewData["Title"] = "My Applications";
}

@* OWNER: Member A (Student role). #4 - track every application. *@

<div class="student-page">

    <div class="page-header">
        <h1>My applications</h1>
        <p class="page-subtitle">Where each of your applications has got to.</p>
    </div>

    <partial name="_StatusMessage" model="(Model.StatusMessage, Model.StatusIsError)" />

    @if (Model.Applications.Count == 0)
    {
        <div class="alert alert-light border">
            You have not applied for anything yet.
            <a asp-page="Scholarships" class="alert-link">Browse scholarships</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle data-table">
                <thead>
                    <tr>
                        <th>Scholarship</th>
                        <th>Submitted</th>
                        <th>Documents</th>
                        <th>Status</th>
                        <th>Score</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.Applications)
                    {
                        var verified = app.Documents.Count(d => d.Status == DocumentStatus.Verified);
                        var flagged = app.Documents.Count(d => d.Status == DocumentStatus.Flagged);

                        <tr>
                            <td>
                                <strong>@app.Scholarship?.Name</strong>
                                <div class="small text-muted">@app.Scholarship?.Provider</div>
                            </td>
                            <td class="text-nowrap">@app.SubmittedOn.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="cell-sub">@verified / @app.Documents.Count verified</span>
                                @if (flagged > 0)
                                {
                                    <div><span class="badge bg-danger">@flagged flagged</span></div>
                                }
                            </td>
                            @* The shared badge decides the colour and the wording, so a
                               status reads the same here as on the officer's queue. *@
                            <td><partial name="_ApplicationStatusBadge" model="app.Status" /></td>
                            <td>@(app.Score?.ToString() ?? "—")</td>
                            <td class="text-end">
                                <a asp-page="Apply" asp-route-id="@app.Id" class="btn btn-outline-primary btn-sm">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/student/student.css" asp-append-version="true" />
}
