@page
@model Grantify.Pages.Student.IndexModel
@{
    ViewData["Title"] = "Student Dashboard";
}

@* OWNER: Member A (Student role). Build all student pages inside Pages/Student/.
   STYLING NOTE: the shared theme in site.css provides the page header and the
   stat tiles, so this page only says WHAT to show. *@

<div class="student-page">

    <div class="page-header">
        <h1>Student dashboard</h1>
        <p class="page-subtitle">Welcome, @User.Identity?.Name.</p>
    </div>

    <partial name="_StatusMessage" model="(Model.StatusMessage, Model.StatusIsError)" />

    @if (!Model.Dashboard.ProfileComplete)
    {
        <div class="alert alert-warning">
            Your profile is not complete, so the eligibility check cannot run properly.
            <a asp-page="Profile" class="alert-link">Complete it now</a>.
        </div>
    }

    @* ---------- Counts ---------- *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">Open scholarships</div>
                <div class="stat-value">@Model.Dashboard.OpenScholarships</div>
                <div class="stat-note">accepting applications now</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">My applications</div>
                <div class="stat-value">@Model.Dashboard.TotalApplications</div>
                <div class="stat-note">submitted in total</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">In progress</div>
                <div class="stat-value">@Model.Dashboard.InProgress</div>
                <div class="stat-note">waiting on a decision</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">Approved</div>
                <div class="stat-value">@Model.Dashboard.Approved</div>
                <div class="stat-note">@Model.Dashboard.Rejected not successful</div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="section-title">Recent applications</h2>

                    @if (Model.Recent.Count == 0)
                    {
                        <p class="cell-sub mb-0">Nothing yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var app in Model.Recent)
                            {
                                <li class="d-flex justify-content-between align-items-start border-bottom py-2">
                                    <div>
                                        <a asp-page="Apply" asp-route-id="@app.Id">@app.Scholarship?.Name</a>
                                        <div class="cell-sub">@app.SubmittedOn.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    </div>
                                    @* The shared badge, so a status looks the same here as it
                                       does on the officer's queue. *@
                                    <partial name="_ApplicationStatusBadge" model="app.Status" />
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="section-title">Next steps</h2>
                    <div class="d-grid gap-2">
                        <a asp-page="Profile" class="btn btn-outline-primary btn-sm">Update my profile</a>
                        <a asp-page="Scholarships" class="btn btn-primary btn-sm">Find scholarships</a>
                        <a asp-page="Applications" class="btn btn-outline-secondary btn-sm">Track my applications</a>
                        <a asp-page="Notifications" class="btn btn-outline-secondary btn-sm">
                            Notifications
                            @if (Model.Dashboard.UnreadNotifications > 0)
                            {
                                <span class="badge bg-primary">@Model.Dashboard.UnreadNotifications</span>
                            }
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/student/student.css" asp-append-version="true" />
}
