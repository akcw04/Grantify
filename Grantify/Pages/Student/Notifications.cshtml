@page
@model Grantify.Pages.Student.NotificationsModel
@{
    ViewData["Title"] = "Notifications";
    var unread = Model.Notifications.Count(n => !n.IsRead);
}

@* OWNER: Member A (Student role). #4 - notifications about updates and decisions. *@

<div class="student-page">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h1>Notifications</h1>
            <p class="text-muted">Updates on your applications and their final decisions.</p>
        </div>

        @if (unread > 0)
        {
            <form method="post" asp-page-handler="MarkAllRead">
                <button type="submit" class="btn btn-outline-secondary btn-sm">
                    Mark all as read (@unread)
                </button>
            </form>
        }
    </div>

    <partial name="_StatusMessage" model="(Model.StatusMessage, Model.StatusIsError)" />

    @if (Model.Notifications.Count == 0)
    {
        <div class="alert alert-light border">
            Nothing yet. You will get a message here when an officer reviews one of
            your applications or makes a decision.
        </div>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (var note in Model.Notifications)
            {
                <li class="card mb-2 @(note.IsRead ? "" : "notification-unread")">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-start flex-wrap">
                            <strong>@note.Title</strong>
                            <span class="small text-muted">
                                @if (!note.IsRead)
                                {
                                    <span class="badge bg-primary me-2">New</span>
                                }
                                @note.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                            </span>
                        </div>

                        <div class="small mt-1">@note.Message</div>

                        <div class="mt-2">
                            <a asp-page="Apply" asp-route-id="@note.ScholarshipApplicationId"
                               class="btn btn-outline-primary btn-sm">Open application</a>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/student/student.css" asp-append-version="true" />
}
