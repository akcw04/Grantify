@page
@model Grantify.Pages.Admin.Institutions.IndexModel
@{
    ViewData["Title"] = "Institutions";
}

@* OWNER: Member C (Admin role). Master data - institutions. *@

<div class="admin-page">
    <div class="page-header admin-toolbar d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1>Institutions</h1>
            <p class="page-subtitle">Schools, universities and organisations linked to scholarships.</p>
        </div>
        <a asp-page="Create" class="btn btn-primary">
            <partial name="_ActionIcon" model="@("new")" />
            New institution
        </a>
    </div>

    <partial name="_StatusMessage" model="(Model.StatusMessage, Model.StatusIsError)" />

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Contact email</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var institution in Model.Institutions)
                        {
                            <tr>
                                <td>@institution.Name</td>
                                <td>@institution.Location</td>
                                <td>@institution.ContactEmail</td>
                                <td class="text-end">
                                    <div class="btn-group admin-actions" role="group" aria-label="Actions">
                                        <a asp-page="Details" asp-route-id="@institution.Id" class="btn btn-sm btn-outline-secondary" title="Details" aria-label="Details">
                                            <partial name="_ActionIcon" model="@("view")" />
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@institution.Id" class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit">
                                            <partial name="_ActionIcon" model="@("edit")" />
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@institution.Id" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete">
                                            <partial name="_ActionIcon" model="@("delete")" />
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (Model.Institutions.Count == 0)
                        {
                            <tr class="empty-row">
                                <td colspan="4">No institutions yet. Use "New institution" to add one.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
