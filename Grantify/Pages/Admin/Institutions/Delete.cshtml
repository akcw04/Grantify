@page "{id:int}"
@model Grantify.Pages.Admin.Institutions.DeleteModel
@{
    ViewData["Title"] = "Delete Institution";
    var institution = Model.Institution!;
}

@* OWNER: Member C (Admin role). Master data - institutions. *@

<div class="admin-page">

    <div class="page-header">
        <h1>Delete institution</h1>
        <p class="page-subtitle">@institution.Name</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"
         style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    @if (Model.InUse)
    {
        <div class="alert alert-warning">
            This institution is still assigned to one or more scholarships, so it cannot be
            deleted. Point those scholarships at a different institution first.
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            Are you sure you want to delete this institution? This cannot be undone.
        </div>
    }

    <div class="card">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@institution.Name</dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(institution.Location) ? "—" : institution.Location)</dd>

                <dt class="col-sm-3">Contact email</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(institution.ContactEmail) ? "—" : institution.ContactEmail)</dd>
            </dl>
        </div>
    </div>

    @* data-confirm asks once more before deleting, using the shared dialog in
       site.js. The button is disabled outright while the row is still in use,
       so nobody presses something that can only fail. *@
    <form method="post" class="mt-3"
          data-confirm="Delete the institution &quot;@institution.Name&quot;?"
          data-confirm-title="Delete institution"
          data-confirm-warning="This cannot be undone."
          data-confirm-label="Yes, delete it">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger" disabled="@Model.InUse">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
