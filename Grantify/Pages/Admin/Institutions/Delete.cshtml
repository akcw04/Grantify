@page "{id:int}"
@model Grantify.Pages.Admin.Institutions.DeleteModel
@{
    ViewData["Title"] = "Delete Institution";
}

<h1>Delete Institution</h1>

@if (Model.Institution is null)
{
    <div class="alert alert-warning">This institution no longer exists.</div>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>
}
else
{
    <div class="alert alert-danger">
        Are you sure you want to delete this institution? This cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Institution.Name</dd>

        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Institution.Location</dd>

        <dt class="col-sm-2">Contact Email</dt>
        <dd class="col-sm-10">@Model.Institution.ContactEmail</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Institution.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
