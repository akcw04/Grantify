@page "{id:int}"
@model Grantify.Pages.Admin.Institutions.DetailsModel
@{
    ViewData["Title"] = "Institution Details";
}

@* OWNER: Member C (Admin role). Master data - institutions. *@

<div class="admin-page">

    <div class="page-header admin-toolbar d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1>Institution details</h1>
            <p class="page-subtitle">@(Model.Institution?.Name ?? "Not found")</p>
        </div>
        @if (Model.Institution is not null)
        {
            <a asp-page="Edit" asp-route-id="@Model.Institution.Id" class="btn btn-primary">
                <partial name="_ActionIcon" model="@("edit")" />
                Edit
            </a>
        }
    </div>

    <div class="card">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Institution!.Name</dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Institution.Location) ? "—" : Model.Institution.Location)</dd>

                <dt class="col-sm-3">Contact email</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Institution.ContactEmail) ? "—" : Model.Institution.ContactEmail)</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
