@page
@model Grantify.Pages.Admin.Institutions.CreateModel
@{
    ViewData["Title"] = "New Institution";
}

@* OWNER: Member C (Admin role). Master data - institutions. *@

<div class="admin-page">

    <div class="page-header">
        <h1>New institution</h1>
        <p class="page-subtitle">A school, university or organisation a scholarship can be linked to.</p>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Name" class="form-label"></label>
                            <input asp-for="Input.Name" class="form-control" placeholder="e.g. Asia Pacific University" />
                            <span asp-validation-for="Input.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Location" class="form-label"></label>
                            <input asp-for="Input.Location" class="form-control" placeholder="Kuala Lumpur, Malaysia" />
                            <span asp-validation-for="Input.Location" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ContactEmail" class="form-label"></label>
                            <input asp-for="Input.ContactEmail" class="form-control" type="email" placeholder="e.g. scholarships@apu.edu.my" />
                            <span asp-validation-for="Input.ContactEmail" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Create</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
