@page
@model Grantify.Pages.Admin.Scholarships.IndexModel
@{
    ViewData["Title"] = "Manage Scholarships";
}

@* OWNER: Member C (Admin role). The scholarship listings students apply for. *@

<div class="admin-page">

    <div class="page-header admin-toolbar d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1>Manage scholarships</h1>
            <p class="page-subtitle">Create, publish and set the eligibility rules for every listing.</p>
        </div>
        <a asp-page="Create" class="btn btn-primary">
            <partial name="_ActionIcon" model="@("new")" />
            New scholarship
        </a>
    </div>

    <partial name="_StatusMessage" model="(Model.StatusMessage, Model.StatusIsError)" />

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Institution</th>
                            <th>Status</th>
                            <th>Deadline</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var scholarship in Model.Scholarships)
                        {
                            <tr>
                                <td>
                                    @scholarship.Name
                                    <div class="cell-sub">@scholarship.Provider</div>
                                </td>
                                <td>@(scholarship.Institution?.Name ?? "—")</td>
                                @* Draft / Published / Closed is worked out from IsPublished
                                   and the deadline — see Scholarship.Status. *@
                                <td><partial name="_ScholarshipStatusBadge" model="scholarship.Status" /></td>
                                <td class="text-nowrap">@scholarship.Deadline.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <div class="btn-group admin-actions" role="group" aria-label="Actions">
                                        <a asp-page="Details" asp-route-id="@scholarship.Id"
                                           class="btn btn-sm btn-outline-secondary" title="Details" aria-label="Details">
                                            <partial name="_ActionIcon" model="@("view")" />
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@scholarship.Id"
                                           class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit">
                                            <partial name="_ActionIcon" model="@("edit")" />
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (Model.Scholarships.Count == 0)
                        {
                            <tr class="empty-row">
                                <td colspan="5">No scholarships yet. Use "New scholarship" to add one.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
