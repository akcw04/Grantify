@page
@model Grantify.Pages.Admin.Scholarships.CreateModel
@{
    ViewData["Title"] = "New Scholarship";
}

<div class="admin-page">
    <div class="page-header">
        <h1>New scholarship</h1>
        <p class="page-subtitle">Set up the listing and its eligibility criteria.</p>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h2 class="section-title">Basic details</h2>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" placeholder="e.g. APU Merit Scholarship" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Provider" class="form-label"></label>
                        <input asp-for="Input.Provider" class="form-control" placeholder="e.g. Asia Pacific University" />
                        <span asp-validation-for="Input.Provider" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="e.g. For students with strong academic results. Covers full tuition for one academic year."></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Deadline" class="form-label"></label>
                        <input asp-for="Input.Deadline" class="form-control" type="date" />
                        <span asp-validation-for="Input.Deadline" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="Input.IsPublished" />
                            <label class="form-check-label" asp-for="Input.IsPublished"></label>
                            <div class="form-text">Closes automatically once the deadline passes.</div>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <h2 class="section-title">Eligibility criteria</h2>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.MinimumCgpa" class="form-label"></label>
                        <input asp-for="Input.MinimumCgpa" class="form-control" type="number" inputmode="decimal" step="0.01" min="0" max="4" placeholder="e.g. 3.00" />
                        <div class="form-text">On a 4.00 scale.</div>
                        <span asp-validation-for="Input.MinimumCgpa" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.MaximumHouseholdIncome" class="form-label"></label>
                        <input asp-for="Input.MaximumHouseholdIncome" class="form-control" type="number" inputmode="decimal" step="0.01" min="0" placeholder="e.g. 5000" />
                        <div class="form-text">Leave blank for no income limit.</div>
                        <span asp-validation-for="Input.MaximumHouseholdIncome" class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <h2 class="section-title">Master data links</h2>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Input.InstitutionId" class="form-label"></label>
                        <select asp-for="Input.InstitutionId" asp-items="Model.InstitutionOptions" class="form-select">
                            <option value="">— None —</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Input.ScholarshipCategoryId" class="form-label"></label>
                        <select asp-for="Input.ScholarshipCategoryId" asp-items="Model.CategoryOptions" class="form-select">
                            <option value="">— None —</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Input.IntakePeriodId" class="form-label"></label>
                        <select asp-for="Input.IntakePeriodId" asp-items="Model.IntakePeriodOptions" class="form-select">
                            <option value="">— None —</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
