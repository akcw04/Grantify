@page "{id:int}"
@model Grantify.Pages.Admin.Scholarships.DetailsModel
@{
    ViewData["Title"] = "Scholarship Details";
    var scholarship = Model.Scholarship!;
}

@* OWNER: Member C (Admin role). Everything set on one listing, read-only. *@

<div class="admin-page">

    <div class="page-header admin-toolbar d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1>Scholarship details</h1>
            <p class="page-subtitle">@scholarship.Name</p>
        </div>
        <a asp-page="Edit" asp-route-id="@scholarship.Id" class="btn btn-primary">
            <partial name="_ActionIcon" model="@("edit")" />
            Edit
        </a>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@scholarship.Name</dd>

                <dt class="col-sm-3">Provider</dt>
                <dd class="col-sm-9">@scholarship.Provider</dd>

                <dt class="col-sm-3">Institution</dt>
                <dd class="col-sm-9">@(scholarship.Institution?.Name ?? "—")</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(scholarship.Description) ? "—" : scholarship.Description)</dd>

                @* Draft / Published / Closed is worked out from IsPublished and the
                   deadline — see Scholarship.Status. *@
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9"><partial name="_ScholarshipStatusBadge" model="scholarship.Status" /></dd>

                <dt class="col-sm-3">Deadline</dt>
                <dd class="col-sm-9">@scholarship.Deadline.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-3">Minimum CGPA</dt>
                <dd class="col-sm-9">@scholarship.MinimumCgpa.ToString("0.00")</dd>

                <dt class="col-sm-3">Maximum household income</dt>
                <dd class="col-sm-9">
                    @(scholarship.MaximumHouseholdIncome is null
                        ? "No limit"
                        : $"RM {scholarship.MaximumHouseholdIncome.Value:N0}")
                </dd>

                <dt class="col-sm-3">Eligible study category</dt>
                <dd class="col-sm-9">@(scholarship.Category?.Name ?? "—")</dd>

                <dt class="col-sm-3">Intake period</dt>
                <dd class="col-sm-9">@(scholarship.IntakePeriod?.PeriodName ?? "—")</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
