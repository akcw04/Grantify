@page "{id:int}"
@using Grantify.Models
@model Grantify.Pages.Admin.Scholarships.DetailsModel
@{
    ViewData["Title"] = "Scholarship Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <div class="admin-toolbar mb-3">
        <h1 class="h3 mb-1">Scholarship Details</h1>
    </div>

    @if (Model.Scholarship is null)
    {
        <div class="alert alert-warning">This scholarship no longer exists.</div>
        <a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>
    }
    else
    {
        var scholarship = Model.Scholarship;
        var statusClass = scholarship.Status switch
        {
            ScholarshipStatus.Published => "text-bg-success",
            ScholarshipStatus.Closed => "text-bg-dark",
            _ => "text-bg-secondary"
        };

        <div class="card admin-card shadow-sm">
            <div class="card-body p-4">
                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@scholarship.Name</dd>

                    <dt class="col-sm-3">Provider</dt>
                    <dd class="col-sm-9">@scholarship.Provider</dd>

                    <dt class="col-sm-3">Institution</dt>
                    <dd class="col-sm-9">@(scholarship.Institution?.Name ?? "—")</dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@scholarship.Description</dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9"><span class="badge rounded-pill @statusClass">@scholarship.Status</span></dd>

                    <dt class="col-sm-3">Deadline</dt>
                    <dd class="col-sm-9">@scholarship.Deadline.ToString("d")</dd>

                    <dt class="col-sm-3">Minimum CGPA</dt>
                    <dd class="col-sm-9">@scholarship.MinimumCgpa.ToString("0.00")</dd>

                    <dt class="col-sm-3">Maximum household income</dt>
                    <dd class="col-sm-9">@(scholarship.MaximumHouseholdIncome?.ToString("0.00") ?? "No limit")</dd>

                    <dt class="col-sm-3">Eligible study category</dt>
                    <dd class="col-sm-9">@(scholarship.Category?.Name ?? "—")</dd>

                    <dt class="col-sm-3">Intake period</dt>
                    <dd class="col-sm-9">@(scholarship.IntakePeriod?.PeriodName ?? "—")</dd>
                </dl>

                <a asp-page="Edit" asp-route-id="@scholarship.Id" class="btn btn-primary">Edit</a>
                <a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>
            </div>
        </div>
    }
</div>
