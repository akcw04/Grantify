@page "{id:int}"
@model Grantify.Pages.Admin.Scholarships.EditModel
@{
    ViewData["Title"] = "Edit Scholarship";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <div class="admin-toolbar mb-3">
        <h1 class="h3 mb-1">Edit Scholarship</h1>
        <p class="text-muted mb-0">@Model.Input.Name</p>
    </div>

    <div class="card admin-card shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <h2 class="h5 mb-3">Basic details</h2>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Provider" class="form-label"></label>
                        <input asp-for="Input.Provider" class="form-control" />
                        <span asp-validation-for="Input.Provider" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Deadline" class="form-label"></label>
                        <input asp-for="Input.Deadline" class="form-control" type="date" />
                        <span asp-validation-for="Input.Deadline" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="Input.IsPublished" />
                            <label class="form-check-label" asp-for="Input.IsPublished"></label>
                            <div class="form-text">Closes automatically once the deadline passes.</div>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <h2 class="h5 mb-3">Eligibility criteria</h2>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.MinimumCgpa" class="form-label"></label>
                        <input asp-for="Input.MinimumCgpa" class="form-control" type="number" step="0.01" min="0" max="4" />
                        <div class="form-text">On a 4.00 scale.</div>
                        <span asp-validation-for="Input.MinimumCgpa" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.MaximumHouseholdIncome" class="form-label"></label>
                        <input asp-for="Input.MaximumHouseholdIncome" class="form-control" type="number" step="0.01" min="0" />
                        <div class="form-text">Leave blank for no income limit.</div>
                        <span asp-validation-for="Input.MaximumHouseholdIncome" class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <h2 class="h5 mb-3">Master data links</h2>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Input.InstitutionId" class="form-label"></label>
                        <select asp-for="Input.InstitutionId" asp-items="Model.InstitutionOptions" class="form-select">
                            <option value="">— None —</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Input.ScholarshipCategoryId" class="form-label"></label>
                        <select asp-for="Input.ScholarshipCategoryId" asp-items="Model.CategoryOptions" class="form-select">
                            <option value="">— None —</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Input.IntakePeriodId" class="form-label"></label>
                        <select asp-for="Input.IntakePeriodId" asp-items="Model.IntakePeriodOptions" class="form-select">
                            <option value="">— None —</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
