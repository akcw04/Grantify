@page "{id:int}"
@model Grantify.Pages.Admin.IntakePeriods.DetailsModel
@{
    ViewData["Title"] = "Intake Period Details";
    var period = Model.IntakePeriod!;
}

@* OWNER: Member C (Admin role). Master data - intake periods. *@

<div class="admin-page">

    <div class="page-header admin-toolbar d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1>Intake period details</h1>
            <p class="page-subtitle">@period.PeriodName</p>
        </div>
        <a asp-page="Edit" asp-route-id="@period.Id" class="btn btn-primary">
            <partial name="_ActionIcon" model="@("edit")" />
            Edit
        </a>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Period name</dt>
                <dd class="col-sm-9">@period.PeriodName</dd>

                <dt class="col-sm-3">Start date</dt>
                <dd class="col-sm-9">@period.StartDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-3">End date</dt>
                <dd class="col-sm-9">@period.EndDate.ToString("dd MMM yyyy")</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
