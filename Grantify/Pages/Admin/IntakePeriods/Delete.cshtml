@page "{id:int}"
@model Grantify.Pages.Admin.IntakePeriods.DeleteModel
@{
    ViewData["Title"] = "Delete Intake Period";
    var period = Model.IntakePeriod!;
}

@* OWNER: Member C (Admin role). Master data - intake periods. *@

<div class="admin-page">

    <div class="page-header">
        <h1>Delete intake period</h1>
        <p class="page-subtitle">@period.PeriodName</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    @if (Model.InUse)
    {
        <div class="alert alert-warning">
            This intake period is still assigned to one or more scholarships, so it cannot be
            deleted. Move those scholarships to a different intake first.
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            Are you sure you want to delete this intake period? This cannot be undone.
        </div>
    }

    <div class="card">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Period name</dt>
                <dd class="col-sm-9">@period.PeriodName</dd>

                <dt class="col-sm-3">Start date</dt>
                <dd class="col-sm-9">@period.StartDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-3">End date</dt>
                <dd class="col-sm-9">@period.EndDate.ToString("dd MMM yyyy")</dd>
            </dl>
        </div>
    </div>

    @* data-confirm asks once more before deleting, using the shared dialog in
       site.js. The button is disabled outright while the row is still in use,
       so nobody presses something that can only fail. *@
    <form method="post" class="mt-3"
          data-confirm="Delete the intake period &quot;@period.PeriodName&quot;?"
          data-confirm-title="Delete intake period"
          data-confirm-warning="This cannot be undone."
          data-confirm-label="Yes, delete it">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger" disabled="@Model.InUse">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
