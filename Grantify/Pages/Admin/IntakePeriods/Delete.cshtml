@page "{id:int}"
@model Grantify.Pages.Admin.IntakePeriods.DeleteModel
@{
    ViewData["Title"] = "Delete Intake Period";
}

<h1>Delete Intake Period</h1>

@if (Model.IntakePeriod is null)
{
    <div class="alert alert-warning">This intake period no longer exists.</div>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>
}
else
{
    <div class="alert alert-danger">
        Are you sure you want to delete this intake period? This cannot be undone.
    </div>

    @if (Model.InUse)
    {
        <div class="alert alert-warning">
            This intake period is still assigned to one or more scholarships and cannot be deleted until they are reassigned.
        </div>
    }

    <dl class="row">
        <dt class="col-sm-2">Period Name</dt>
        <dd class="col-sm-10">@Model.IntakePeriod.PeriodName</dd>

        <dt class="col-sm-2">Start Date</dt>
        <dd class="col-sm-10">@Model.IntakePeriod.StartDate.ToString("d")</dd>

        <dt class="col-sm-2">End Date</dt>
        <dd class="col-sm-10">@Model.IntakePeriod.EndDate.ToString("d")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="IntakePeriod.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
