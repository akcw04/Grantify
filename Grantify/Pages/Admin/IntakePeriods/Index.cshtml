@page
@model Grantify.Pages.Admin.IntakePeriods.IndexModel
@{
    ViewData["Title"] = "Intake Periods";
}

@* OWNER: Member C (Admin role). Master data - intake periods. *@

<div class="admin-page">
    <div class="page-header admin-toolbar d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1>Intake periods</h1>
            <p class="page-subtitle">Application windows that scholarships can be tied to (e.g. "Fall 2026 Intake").</p>
        </div>
        <a asp-page="Create" class="btn btn-primary">
            <partial name="_ActionIcon" model="@("new")" />
            New intake period
        </a>
    </div>

    <partial name="_StatusMessage" model="(Model.StatusMessage, Model.StatusIsError)" />

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle data-table">
                    <thead>
                        <tr>
                            <th>Period name</th>
                            <th>Start date</th>
                            <th>End date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var period in Model.IntakePeriods)
                        {
                            <tr>
                                <td>@period.PeriodName</td>
                                <td>@period.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@period.EndDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <div class="btn-group admin-actions" role="group" aria-label="Actions">
                                        <a asp-page="Details" asp-route-id="@period.Id" class="btn btn-sm btn-outline-secondary" title="Details" aria-label="Details">
                                            <partial name="_ActionIcon" model="@("view")" />
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@period.Id" class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit">
                                            <partial name="_ActionIcon" model="@("edit")" />
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@period.Id" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete">
                                            <partial name="_ActionIcon" model="@("delete")" />
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (Model.IntakePeriods.Count == 0)
                        {
                            <tr class="empty-row">
                                <td colspan="4">No intake periods yet. Use "New intake period" to add one.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
