@page
@model Grantify.Pages.Admin.IntakePeriods.CreateModel
@{
    ViewData["Title"] = "New Intake Period";
}

@* OWNER: Member C (Admin role). Master data - intake periods. *@

<div class="admin-page">

    <div class="page-header">
        <h1>New intake period</h1>
        <p class="page-subtitle">A named application window, such as "Fall 2026 Intake".</p>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.PeriodName" class="form-label"></label>
                            <input asp-for="Input.PeriodName" class="form-control" placeholder="Fall 2026 Intake" />
                            <span asp-validation-for="Input.PeriodName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.StartDate" class="form-label"></label>
                                <input asp-for="Input.StartDate" class="form-control" type="date" />
                                <span asp-validation-for="Input.StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.EndDate" class="form-label"></label>
                                <input asp-for="Input.EndDate" class="form-control" type="date" />
                                <div class="form-text">Must not be before the start date.</div>
                                <span asp-validation-for="Input.EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary">Create</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
