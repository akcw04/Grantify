@page
@model Grantify.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

@* OWNER: Member C (Admin role). Every registered account, and whether it can
   still sign in. Accounts are created by the person registering; what an
   administrator controls here is access. *@

<div class="admin-page">

    <div class="page-header">
        <h1>Manage users</h1>
        <p class="page-subtitle">Activate, deactivate and assign the officer role for every registered account.</p>
    </div>

    <partial name="_StatusMessage" model="(Model.StatusMessage, Model.StatusIsError)" />

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Roles</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    @* The name is what an administrator recognises; the email
                                       is how the account is identified. Show both. *@
                                    @(string.IsNullOrWhiteSpace(user.FullName) ? "(no name given)" : user.FullName)
                                    <div class="cell-sub">@user.Email</div>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Roles.Count == 0)
                                    {
                                        @* Should not happen: registering puts an account in the
                                           Student role. If it does, that person cannot open any
                                           page at all, so it needs to be visible, not blank. *@
                                        <span class="badge bg-warning text-dark">No role</span>
                                    }
                                    else
                                    {
                                        foreach (var role in user.Roles)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@role</span>
                                        }
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group admin-actions" role="group" aria-label="Actions">
                                        <a asp-page="Edit" asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit">
                                            <partial name="_ActionIcon" model="@("edit")" />
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (Model.Users.Count == 0)
                        {
                            <tr class="empty-row">
                                <td colspan="4">No registered users yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
