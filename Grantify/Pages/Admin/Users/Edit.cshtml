@page "{id}"
@model Grantify.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <div class="d-flex flex-wrap justify-content-between align-items-center admin-toolbar mb-3">
        <div>
            <h1 class="h3 mb-1">Edit User</h1>
            <p class="text-muted mb-0">@Model.Email</p>
        </div>
    </div>

    <div class="card admin-card shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="Id" />

                <dl class="row mb-4">
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Email</dd>
                    <dt class="col-sm-3">Full Name</dt>
                    <dd class="col-sm-9">@Model.FullName</dd>
                </dl>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="Input.IsActive" />
                    <label class="form-check-label" asp-for="Input.IsActive"></label>
                    <div class="form-text">Deactivated users cannot sign in.</div>
                </div>

                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="Input.IsOfficer" />
                    <label class="form-check-label" asp-for="Input.IsOfficer"></label>
                    <div class="form-text">Grants access to the officer review queue.</div>
                </div>

                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
