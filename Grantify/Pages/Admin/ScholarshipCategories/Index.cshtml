@page
@model Grantify.Pages.Admin.ScholarshipCategories.IndexModel
@{
    ViewData["Title"] = "Scholarship Categories";
}

@* OWNER: Member C (Admin role). Master data - scholarship categories. *@

<div class="admin-page">
    <div class="page-header admin-toolbar d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1>Scholarship categories</h1>
            <p class="page-subtitle">Categories used to group scholarships (e.g. STEM, Sports, Need-based).</p>
        </div>
        <a asp-page="Create" class="btn btn-primary">
            <partial name="_ActionIcon" model="@("new")" />
            New category
        </a>
    </div>

    <partial name="_StatusMessage" model="(Model.StatusMessage, Model.StatusIsError)" />

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td>@category.Name</td>
                                <td>@category.Description</td>
                                <td class="text-end">
                                    <div class="btn-group admin-actions" role="group" aria-label="Actions">
                                        <a asp-page="Details" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary" title="Details" aria-label="Details">
                                            <partial name="_ActionIcon" model="@("view")" />
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit">
                                            <partial name="_ActionIcon" model="@("edit")" />
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete">
                                            <partial name="_ActionIcon" model="@("delete")" />
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (Model.Categories.Count == 0)
                        {
                            <tr class="empty-row">
                                <td colspan="3">No categories yet. Use "New category" to add one.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
