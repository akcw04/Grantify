@page "{id:int}"
@model Grantify.Pages.Admin.ScholarshipCategories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Scholarship Category</h1>

@if (Model.Category is null)
{
    <div class="alert alert-warning">This category no longer exists.</div>
    <a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>
}
else
{
    <div class="alert alert-danger">
        Are you sure you want to delete this category? This cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Category.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Category.Description</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Category.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
