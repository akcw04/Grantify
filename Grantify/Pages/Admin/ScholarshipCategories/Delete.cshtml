@page "{id:int}"
@model Grantify.Pages.Admin.ScholarshipCategories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
    var category = Model.Category!;
}

@* OWNER: Member C (Admin role). Master data - scholarship categories. *@

<div class="admin-page">

    <div class="page-header">
        <h1>Delete category</h1>
        <p class="page-subtitle">@category.Name</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    @if (Model.InUse)
    {
        <div class="alert alert-warning">
            This category is still assigned to one or more scholarships, so it cannot be
            deleted. Move those scholarships to a different category first.
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            Are you sure you want to delete this category? This cannot be undone.
        </div>
    }

    <div class="card">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@category.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(category.Description) ? "—" : category.Description)</dd>
            </dl>
        </div>
    </div>

    @* data-confirm asks once more before deleting, using the shared dialog in
       site.js. The button is disabled outright while the row is still in use,
       so nobody presses something that can only fail. *@
    <form method="post" class="mt-3"
          data-confirm="Delete the category &quot;@category.Name&quot;?"
          data-confirm-title="Delete category"
          data-confirm-warning="This cannot be undone."
          data-confirm-label="Yes, delete it">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger" disabled="@Model.InUse">Delete</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
