@page "{id:int}"
@model Grantify.Pages.Admin.ScholarshipCategories.DetailsModel
@{
    ViewData["Title"] = "Category Details";
    var category = Model.Category!;
}

@* OWNER: Member C (Admin role). Master data - scholarship categories. *@

<div class="admin-page">

    <div class="page-header admin-toolbar d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1>Category details</h1>
            <p class="page-subtitle">@category.Name</p>
        </div>
        <a asp-page="Edit" asp-route-id="@category.Id" class="btn btn-primary">
            <partial name="_ActionIcon" model="@("edit")" />
            Edit
        </a>
    </div>

    <div class="card">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@category.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(category.Description) ? "—" : category.Description)</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
