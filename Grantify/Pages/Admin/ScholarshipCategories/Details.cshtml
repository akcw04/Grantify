@page "{id:int}"
@model Grantify.Pages.Admin.ScholarshipCategories.DetailsModel
@{
    ViewData["Title"] = "Category Details";
}

<h1>Category Details</h1>

@if (Model.Category is null)
{
    <div class="alert alert-warning">This category no longer exists.</div>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Category.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Category.Description</dd>
    </dl>

    <a asp-page="Edit" asp-route-id="@Model.Category.Id" class="btn btn-primary">Edit</a>
}
<a asp-page="Index" class="btn btn-outline-secondary">Back to list</a>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
}
